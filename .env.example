# Copie este arquivo para .env e preencha os valores
# NUNCA envie o arquivo .env real para o GitHub

# Segredo para assinatura dos tokens JWT (mínimo 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=substitua_por_uma_chave_secreta_de_no_minimo_32_caracteres_aleatorios

# Porta em que o servidor vai rodar
PORT=3000

# Caminho para o arquivo de banco de dados SQLite
DB_PATH=./data/docvault.db
